{
  "name": "coffee-chat-crm",
  "version": "1.0.0",
  "description": "A Chrome extension that turns LinkedIn coffee chats and networking emails into a lightweight, local-first CRM: one click on LinkedIn to log a contact, automatic Gmail thread matching, and a follow-up queue that tells you who to reach out to next.",
  "private": true,
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "build:icons": "node scripts/build-icons.js",
    "package": "node scripts/package-extension.js"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "babel-jest": "^30.4.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "pngjs": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/lib/**/*.js"
    ],
    "coverageDirectory": "coverage"
  },
  "license": "MIT"
}
