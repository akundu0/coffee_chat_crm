{
  "manifest_version": 3,
  "name": "Coffee Chat CRM",
  "short_name": "Coffee Chat CRM",
  "version": "1.0.0",
  "description": "Log LinkedIn coffee chats with one click, auto-match Gmail follow-ups, and never lose track of a networking contact again.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "src/options/options.html",
  "background": {
    "service_worker": "src/background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["src/content/linkedin-content.js"],
      "css": ["src/content/linkedin-content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/lib/linkedinParser.js"],
      "matches": ["https://www.linkedin.com/*"]
    }
  ],
  "permissions": ["storage", "identity", "alarms", "notifications"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://gmail.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  },
  "minimum_chrome_version": "116"
}
